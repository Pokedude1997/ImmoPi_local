{
  "name": "immopi-server",
  "version": "1.0.0",
  "description": "ImmoPi Manager Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "start:test": "NODE_ENV=test node server.js",
    "stop:prod": "pkill -f 'NODE_ENV=production.*node server.js'",
    "stop:test": "pkill -f 'NODE_ENV=test.*node server.js'",
    "backup": "node backup.js",
    "hash-password": "node auth-middleware.js hash"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "sqlite3": "^5.1.7",
    "zod": "^3.22.4"
  },
  "keywords": [
    "real-estate",
    "property-management",
    "raspberry-pi",
    "ai",
    "document-analysis"
  ],
  "author": "Christopher",
  "license": "MIT",
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10"
  }
}
