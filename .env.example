# ImmoPi Manager environment variables

# Server settings
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Authentication
# Use either APP_PASSWORD or APP_PASSWORD_HASH.
APP_PASSWORD=YourSecurePassword123!
# APP_PASSWORD_HASH=

# Google Gemini AI (optional for local preview)
API_KEY=your_gemini_api_key_here

# Google Drive configuration
GOOGLE_DRIVE_DOCUMENTS_FOLDER_ID=your_documents_folder_id
GOOGLE_DRIVE_FOLDER_ID=your_backups_folder_id
GOOGLE_CREDENTIALS_PATH=./google-credentials.json
